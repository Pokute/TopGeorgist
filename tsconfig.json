{
	"compilerOptions": {
		"outDir": "./compiled/",
		"sourceMap": true,
		"strictNullChecks": true,
		"module": "NodeNext",
		"moduleResolution": "nodenext",
		"jsx": "react",
		"target": "ES2024",
		"strict": true,
        "lib": [
            "ES2024",
			"DOM"
        ],
        "resolveJsonModule": true,
		"rootDir": "",
		"verbatimModuleSyntax": true,
		"rewriteRelativeImportExtensions": true,
		"allowImportingTsExtensions": true
	},
	"compileOnSave": true,
	"files": [
		"./typings/global.d.ts"
	],
	"exclude": [
		"node_modules"
	]
}
